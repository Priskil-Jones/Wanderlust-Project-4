

<!-- Success Flash -->
<% if (locals.successMsg && successMsg.length) { %>
    <div class="alert alert-success alert-dismissible fade show col-6 offset-3" role="alert">
        <%= successMsg %>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
<% } %>


<!-- Error Flash -->
<% if (locals.errorMsg && errorMsg.length) { %>
    <div class="alert alert-danger alert-dismissible fade show col-6 offset-3" role="alert">
        <%= errorMsg %>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
<% } %>

<!-- Delete Flash -->
<% if (locals.deleteMsg && deleteMsg.length) { %>
    <div class="alert alert-primary alert-dismissible fade show col-6 offset-3" role="alert">
        <%= deleteMsg %>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
<% } %>